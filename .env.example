# ==============================================================================
# WorkTree AI (worktree.ai) — Local Network & Port Configuration
# ==============================================================================
# Change these ports if you have other projects already running on ports 3000 or 8000.

# 1. Next.js Web Dashboard Port (Default: 3003)
# Configured so it doesn't conflict with other React/Next apps on port 3000
WT_WEB_PORT=3003

# 2. Python FastAPI Cloud Backend Port & Host (Default: 8000)
WT_CLOUD_PORT=8000
WT_CLOUD_HOST=0.0.0.0

# 3. Public Cloud URL for Web Dashboard Browser Requests
NEXT_PUBLIC_API_URL=http://localhost:8000

# 4. Cloud URL for VS Code IDE Extension
WT_CLOUD_URL=http://localhost:8000

# 5. Optional GitHub Personal Access Token (PAT) for 180-day backfill
# Unauthenticated GitHub API is limited to 60 req/hr; add a token for 5,000 req/hr
GITHUB_TOKEN=
